DATABASE_URL=postgres://postgres:postgres@localhost:5432/flashgame
ADMIN_API_KEY=change-me-to-a-long-random-secret
HOUSEHOLD_SYNC_TOKEN=change-me-to-a-long-random-family-sync-secret
HOST=0.0.0.0
PORT=3000
LOCAL_MEDIA_ROOT=uploads

# S3-compatible object storage. Cloudflare R2 works here.
# Leave empty in local dev if media upload URLs are not needed.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
UPLOAD_URL_EXPIRES_SECONDS=900
